# Copia este archivo a .env y completa los valores. .env NO se sube a git.
# Genera un secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio

# Solo app final (HU-01 en adelante)
# Clave del administrador general (pantalla /admin, encabezado X-Admin-Key). Mínimo 16 caracteres.
ADMIN_KEY=cambia-esto-tambien
# Dónde se guardan los datos: memory (se pierden al apagar) | dynamodb (AWS; lo pone la plantilla)
REPOSITORY_BACKEND=memory
# Nombres de las tablas cuando REPOSITORY_BACKEND=dynamodb (la plantilla los define sola en AWS)
NODES_TABLE=NodesTable
RECORDS_TABLE=RecordsTable
TOKENS_TABLE=TokensTable
AWS_REGION=us-east-2
